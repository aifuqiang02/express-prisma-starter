# development | test | production
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
LOG_DIR=./logs
LOG_RETENTION_DAYS=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/express_prisma_starter?schema=public
# Production secret: use a long random string, at least 16 chars
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret
# Production secret: use a different long random string, at least 16 chars
JWT_REFRESH_SECRET=replace-me-with-a-second-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
